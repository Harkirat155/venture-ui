{
  "name": "@venture-ui/ui",
  "version": "0.0.0",
  "description": "Astryx integration package for venture-ui: shared components Astryx lacks.",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist",
    "astryx.integration.ts",
    "src",
    "templates",
    "!src/**/*.test.*"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./Timeline": {
      "types": "./dist/Timeline/Timeline.d.ts",
      "default": "./dist/Timeline/Timeline.js"
    },
    "./templates/timeline-showcase": "./templates/timeline-showcase.tsx",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json && astryx integration check --strict --next"
  },
  "peerDependencies": {
    "@astryxdesign/core": "0.7.4",
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@astryxdesign/cli": "0.7.4",
    "@astryxdesign/core": "0.7.4",
    "@stylexjs/stylex": "0.19.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "30.1.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
