{
  "name": "venture-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "theme:build": "astryx theme build examples/minimal-product/src/theme.ts",
    "theme:check": "astryx theme build examples/minimal-product/src/theme.ts --check",
    "size": "size-limit"
  },
  "devDependencies": {
    "@astryxdesign/cli": "0.7.4",
    "@astryxdesign/core": "0.7.4",
    "@size-limit/preset-app": "14.3.0",
    "@types/node": "24.19.2",
    "size-limit": "14.3.0",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
